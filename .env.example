# Public values are included in browser-visible output. Never put secrets here.
PUBLIC_SITE_URL=
PUBLIC_TURNSTILE_SITE_KEY=
# Live endpoints must verify Turnstile server-side and accept multipart FormData.
PUBLIC_LEGAL_INTAKE_ENDPOINT=
PUBLIC_MEDIATION_INTAKE_ENDPOINT=
# Full HTTPS URLs for the actual booking calendars.
PUBLIC_LEGAL_CALENDAR_URL=
PUBLIC_MEDIATION_CALENDAR_URL=
