---
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath: string; }
const { title, description, canonicalPath } = Astro.props;
if (!canonicalPath.startsWith('/') || canonicalPath.startsWith('//')) {
  throw new Error('canonicalPath must be a root-relative path.');
}
const pageTitle = `${title} | Rowe Law Office, LLC`;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E2F24" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Rowe Law Office, LLC" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="fixed top-3 left-3 z-[100] -translate-y-32 bg-gold px-5 py-3 font-semibold text-onyx focus:translate-y-0">Skip to main content</a>
    <Navigation />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
