---
import { practiceAreas } from '../data/navigation';
const year = new Date().getFullYear();
---
<footer class="border-t border-gold/40 bg-forest-dark text-parchment">
  <div class="container-shell grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-[1.3fr_1.2fr_1fr_1fr]">
    <div>
      <a href="/" class="font-serif text-2xl">Rowe Law Office, LLC</a>
      <p class="mt-4 text-sm font-semibold text-gold-light">Patrick Rowe<br />Attorney &amp; Mediator</p>
      <p class="mt-4 max-w-xs text-sm leading-7 text-parchment/75">A virtual practice providing Wisconsin legal representation and neutral mediation for Wisconsin disputes and Florida family law.</p>
    </div>
    <nav aria-label="Footer Wisconsin practice areas">
      <h2 class="mb-4 font-sans text-sm font-semibold text-gold-light">Wisconsin Practice Areas</h2>
      <ul class="space-y-1">{practiceAreas.map((area) => <li><a class="footer-link" href={area.href}>{area.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Footer firm and mediation">
      <h2 class="mb-4 font-sans text-sm font-semibold text-gold-light">Mediation &amp; Our Firm</h2>
      <ul class="space-y-2">
        <li><a class="footer-link" href="/mediation">Virtual Mediation (WI &amp; FL)</a></li>
        <li><a class="footer-link" href="/about">About Patrick Rowe</a></li>
        <li><a class="footer-link" href="/legal-services">Wisconsin Legal Services</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="mb-4 font-sans text-sm font-semibold text-gold-light">Contact &amp; Appointments</h2>
      <ul class="space-y-2">
        <li><a class="footer-link" href="/contact">Contact &amp; Intake</a></li>
        <li><a class="footer-link" href="/contact">Book Virtual Consultation</a></li>
      </ul>
      <p class="mt-5 text-sm leading-7 text-parchment/75"><span class="font-semibold text-parchment">Office hours</span><br />By appointment<br />Virtual via Secure Video/Phone</p>
    </div>
  </div>
  <div class="border-t border-parchment/10 bg-onyx py-8">
    <div class="container-shell">
      <p class="max-w-6xl text-sm leading-7 text-parchment/65">The information provided on this website does not, and is not intended to, constitute legal advice. Submitting an inquiry does not form an attorney-client relationship. Legal representation is strictly limited to Wisconsin matters. Mediation services are neutral dispute resolution and available for Wisconsin disputes and Florida family law.</p>
      <p class="mt-6 text-xs text-parchment/55">&copy; {year} Rowe Law Office, LLC. All rights reserved.</p>
    </div>
  </div>
</footer>
