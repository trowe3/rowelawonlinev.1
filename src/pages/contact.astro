---
import BaseLayout from '../components/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
function configuredURL(value: string | undefined): string {
  if (!value?.trim()) return '';
  const url = new URL(value);
  if (url.protocol !== 'https:') throw new Error('Intake and calendar URLs must use HTTPS.');
  return url.href;
}
const legalEndpoint = configuredURL(import.meta.env.PUBLIC_LEGAL_INTAKE_ENDPOINT);
const mediationEndpoint = configuredURL(import.meta.env.PUBLIC_MEDIATION_INTAKE_ENDPOINT);
const legalCalendar = configuredURL(import.meta.env.PUBLIC_LEGAL_CALENDAR_URL);
const mediationCalendar = configuredURL(import.meta.env.PUBLIC_MEDIATION_CALENDAR_URL);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
const verificationConfigured = Boolean(siteKey && siteKey !== 'YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY');
const legalLive = Boolean(legalEndpoint && verificationConfigured);
const mediationLive = Boolean(mediationEndpoint && verificationConfigured);
const practiceAreas = ['Divorce/Family Law', 'Custody', 'Guardianship', 'Estate & Medicaid', 'Business Succession', 'Real Estate', 'GAL Stipulation'];
---
<BaseLayout title="Contact & Virtual Intake | Wisconsin Legal Counsel & Mediation" description="Choose Wisconsin legal representation or neutral virtual mediation in Wisconsin or Florida. Contact Rowe Law Office, LLC and request a remote consultation." canonicalPath="/contact">
  <section class="contact-hero border-b border-gold/40 bg-forest text-parchment" aria-labelledby="contact-title">
    <div class="container-shell py-10 sm:py-14">
      <nav aria-label="Breadcrumb" class="mb-10 text-sm leading-7 text-gold-light"><ol class="flex flex-wrap gap-3"><li><a href="/" class="hover:underline underline-offset-4">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">Contact &amp; Intake</li></ol></nav>
      <h1 id="contact-title" class="max-w-4xl text-4xl leading-[1.15] sm:text-5xl lg:text-6xl">Let’s Connect—Completely on Your Schedule</h1>
      <p class="mt-7 max-w-4xl text-lg leading-8 text-parchment/85">Please choose whether you are seeking Wisconsin legal representation or neutral virtual mediation in Wisconsin or Florida.</p>
    </div>
  </section>
  <div class="container-shell py-12 sm:py-16">
    <aside aria-label="Legal notice and disclaimer" class="mb-10 border-2 border-gold bg-onyx p-7 text-parchment sm:p-9">
      <p class="text-base leading-8"><strong class="text-gold-light">LEGAL NOTICE &amp; DISCLAIMER:</strong> Submission of information through this website or contact form does not create an attorney-client relationship between you and Rowe Law Office, LLC or Patrick Rowe. Please do not send confidential or time-sensitive information until a formal conflict check has been completed and a written representation agreement has been executed. Legal representation is strictly limited to Wisconsin matters. Virtual mediation services are neutral dispute resolution and available for Wisconsin disputes and Florida family law.</p>
    </aside>
    <div class="grid items-start gap-8 xl:grid-cols-2">
      <section aria-labelledby="legal-intake-title" class="min-w-0 border border-forest/25 bg-white p-6 sm:p-9">
        <h2 id="legal-intake-title" class="text-3xl leading-tight text-forest">Wisconsin Legal Representation</h2>
        <p class="mt-4 text-base leading-8 text-onyx/75">For prospective clients seeking an attorney for a Wisconsin legal matter.</p>
        <p id="legal-form-notice" class="mt-5 border-l-2 border-gold bg-forest/5 px-4 py-3 text-sm leading-7 text-forest">{legalLive ? 'Please provide general information only. Required fields are marked with an asterisk (*).' : 'Demo intake form: inquiries are not sent. Use sample information only. Required fields are marked with an asterisk (*).'}</p>
        <form id="legal-intake" data-intake-form data-kind="legal" data-endpoint={legalLive ? legalEndpoint : ''} aria-describedby="legal-form-notice" class="mt-7 space-y-6" method="post" action={legalLive ? legalEndpoint : '/contact'}>
          <input type="hidden" name="intake_type" value="wisconsin-legal" />
          <div><label for="legal-name" class="field-label">Full Name <span aria-hidden="true">*</span></label><input class="form-field" id="legal-name" name="full_name" autocomplete="name" maxlength="150" required /></div>
          <div class="grid gap-6 sm:grid-cols-2"><div><label for="legal-email" class="field-label">Email <span aria-hidden="true">*</span></label><input class="form-field" type="email" id="legal-email" name="email" autocomplete="email" maxlength="254" required /></div><div><label for="legal-phone" class="field-label">Phone Number <span aria-hidden="true">*</span></label><input class="form-field" type="tel" id="legal-phone" name="phone" autocomplete="tel" maxlength="40" required /></div></div>
          <div><label for="legal-county" class="field-label">Wisconsin County <span aria-hidden="true">*</span></label><input class="form-field" id="legal-county" name="wisconsin_county" maxlength="80" required /></div>
          <div><label for="legal-practice" class="field-label">Practice Area <span aria-hidden="true">*</span></label><select class="form-field" id="legal-practice" name="practice_area" required><option value="" disabled selected>Select a practice area</option>{practiceAreas.map((area) => <option value={area}>{area}</option>)}</select></div>
          <div><label for="legal-description" class="field-label">Brief Description of Your Legal Need <span aria-hidden="true">*</span></label><textarea class="form-field min-h-36 resize-y" id="legal-description" name="description" rows="5" maxlength="2000" aria-describedby="legal-description-help" required></textarea><p id="legal-description-help" class="mt-2 text-sm leading-7 text-onyx/65">General details only. Do not include confidential or time-sensitive information.</p></div>
          <TurnstileWidget action="legal-intake" />
          <button type="submit" disabled class="submit-button">Request Consultation</button>
          <p data-intake-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1" class="hidden border-l-4 border-gold bg-forest/5 p-4 text-sm leading-7 text-forest"></p>
          <div class="border-t border-forest/15 pt-6">{legalCalendar ? <CTAButton href={legalCalendar} variant="outline" classes="w-full" style="border-color: #C5A880">Schedule Directly via Online Calendar</CTAButton> : <button type="button" data-calendar-unavailable class="booking-button">Schedule Directly via Online Calendar</button>}</div>
          <noscript><p class="text-sm leading-7 text-forest">JavaScript is required for verification and interactive intake. Enable JavaScript to use this form.</p></noscript>
        </form>
      </section>
      <section aria-labelledby="mediation-intake-title" class="min-w-0 border border-gold/60 bg-forest p-6 text-parchment sm:p-9">
        <h2 id="mediation-intake-title" class="text-3xl leading-tight">Virtual Dispute Resolution</h2>
        <p class="mt-4 text-base leading-8 text-parchment/85">For parties or attorneys seeking a neutral mediator in Wisconsin or for Florida family law.</p>
        <p id="mediation-form-notice" class="mt-5 border-l-2 border-gold bg-forest-dark px-4 py-3 text-sm leading-7 text-parchment">{mediationLive ? 'Mediation is neutral facilitation, not legal representation. Required fields are marked with an asterisk (*).' : 'Demo intake form: inquiries are not sent. Use sample information only. Required fields are marked with an asterisk (*).'}</p>
        <form id="mediation-intake" data-intake-form data-kind="mediation" data-endpoint={mediationLive ? mediationEndpoint : ''} aria-describedby="mediation-form-notice" class="mt-7 space-y-6" method="post" action={mediationLive ? mediationEndpoint : '/contact'}>
          <input type="hidden" name="intake_type" value="mediation" />
          <div><label for="mediation-name" class="field-label">Initiating Party/Attorney Name <span aria-hidden="true">*</span></label><input class="form-field" id="mediation-name" name="initiating_name" autocomplete="name" maxlength="150" required /></div>
          <div class="grid gap-6 sm:grid-cols-2"><div><label for="mediation-email" class="field-label">Email <span aria-hidden="true">*</span></label><input class="form-field" type="email" id="mediation-email" name="email" autocomplete="email" maxlength="254" required /></div><div><label for="mediation-phone" class="field-label">Phone Number <span aria-hidden="true">*</span></label><input class="form-field" type="tel" id="mediation-phone" name="phone" autocomplete="tel" maxlength="40" required /></div></div>
          <div><label for="mediation-state" class="field-label">State of Jurisdiction <span aria-hidden="true">*</span></label><select class="form-field" id="mediation-state" name="jurisdiction" required><option value="" disabled selected>Select a state</option><option value="Wisconsin">Wisconsin</option><option value="Florida">Florida</option></select></div>
          <div><label for="mediation-dispute" class="field-label">Dispute Type <span aria-hidden="true">*</span></label><select class="form-field" id="mediation-dispute" name="dispute_type" required><option value="" disabled selected>Select a dispute type</option><option value="Family Law">Family Law</option><option value="Estate/Probate">Estate/Probate</option><option value="Real Estate">Real Estate</option><option value="Civil Dispute">Civil Dispute</option></select><p id="mediation-dispute-help" class="mt-2 text-sm leading-7 text-parchment/80">Florida mediation is limited to family law matters.</p></div>
          <div><label for="mediation-opposing" class="field-label">Opposing Party / Co-Parent Name &amp; Contact Info <span class="font-normal">(Optional)</span></label><textarea class="form-field min-h-28 resize-y" id="mediation-opposing" name="opposing_contact" rows="3" maxlength="1000" aria-describedby="mediation-opposing-help"></textarea><p id="mediation-opposing-help" class="mt-2 text-sm leading-7 text-parchment/80">Share only contact information you are authorized to provide.</p></div>
          <TurnstileWidget action="mediation-intake" />
          <button type="submit" disabled class="submit-button">Submit Mediation Inquiry</button>
          <p data-intake-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1" class="hidden border-l-4 border-gold bg-forest-dark p-4 text-sm leading-7 text-parchment"></p>
          <div class="border-t border-gold/30 pt-6">{mediationCalendar ? <CTAButton href={mediationCalendar} variant="secondary" classes="w-full">Book Virtual Mediation Session</CTAButton> : <button type="button" data-calendar-unavailable class="booking-button">Book Virtual Mediation Session</button>}</div>
          <noscript><p class="text-sm leading-7">JavaScript is required for verification and interactive intake. Enable JavaScript to use this form.</p></noscript>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>
<script>
  import { resetVerification } from '../scripts/turnstile';
  document.querySelectorAll<HTMLFormElement>('[data-intake-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-intake-status]');
    if (button) button.disabled = false;
    const notify = (message: string): void => {
      if (!status) return;
      status.classList.remove('hidden'); status.textContent = message; status.focus();
    };
    const state = form.querySelector<HTMLSelectElement>('[name="jurisdiction"]');
    const dispute = form.querySelector<HTMLSelectElement>('[name="dispute_type"]');
    const limitFlorida = (): void => {
      if (!state || !dispute) return;
      const florida = state.value === 'Florida';
      Array.from(dispute.options).forEach((option) => { option.disabled = florida && Boolean(option.value) && option.value !== 'Family Law'; });
      if (florida) dispute.value = 'Family Law';
    };
    state?.addEventListener('change', limitFlorida);
    form.querySelector('[data-calendar-unavailable]')?.addEventListener('click', () => notify('Online booking is not yet available. Calendar details will be added before live intake opens.'));
    let pending = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (pending || !form.reportValidity()) return;
      if (state?.value === 'Florida' && dispute?.value !== 'Family Law') { notify('Florida mediation is limited to family law matters.'); return; }
      const endpoint = form.dataset.endpoint;
      const success = form.dataset.kind === 'legal' ? 'Thank you. Our office will review your inquiry within one business day.' : 'Thank you. Our office will review your mediation inquiry within one business day.';
      if (!endpoint) { notify(`Demo only — this inquiry has not been sent. Preview confirmation: ${success}`); return; }
      const token = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value;
      if (!token) { notify('Please complete the security verification before submitting.'); return; }
      pending = true;
      const originalLabel = button?.textContent || '';
      if (button) { button.disabled = true; button.textContent = 'Submitting…'; }
      form.setAttribute('aria-busy', 'true');
      try {
        const response = await fetch(endpoint, { method: 'POST', body: new FormData(form), credentials: 'omit', signal: AbortSignal.timeout(15000) });
        if (!response.ok) { notify('Your inquiry was not confirmed. Please check the form and security verification, then try again.'); return; }
        form.reset(); limitFlorida(); notify(success);
      } catch {
        notify('We could not confirm delivery. Please check your connection and contact the office before resubmitting a time-sensitive inquiry.');
      } finally {
        resetVerification(form); pending = false; form.removeAttribute('aria-busy');
        if (button) { button.disabled = false; button.textContent = originalLabel; }
      }
    });
  });
</script>
<style>
  .contact-hero { background-image: radial-gradient(ellipse at top right, rgb(22 67 52 / 0.75), rgb(11 13 12 / 0.55)); }
  .field-label { display: block; margin-bottom: 0.65rem; font-size: 0.875rem; font-weight: 600; line-height: 1.6; }
  .form-field { display: block; width: 100%; min-width: 0; min-height: 3rem; border: 1px solid #A88A60; background: #F9FAF7; color: #0B0D0C; padding: 0.8rem; font: inherit; font-size: 1rem; line-height: 1.5; border-radius: 0; }
  .submit-button, .booking-button { display: inline-flex; width: 100%; min-height: 3rem; align-items: center; justify-content: center; border: 1px solid #C5A880; padding: 0.8rem 1rem; font-size: 0.875rem; font-weight: 600; line-height: 1.6; text-align: center; transition: background-color 150ms; }
  .submit-button { background: #C5A880; color: #0B0D0C; }
  .submit-button:hover { background: #D6BC96; }
  .submit-button:disabled { cursor: wait; opacity: 0.65; }
  .booking-button { background: transparent; color: inherit; }
  .booking-button:hover { background: rgb(197 168 128 / 0.12); }
</style>
