---
import LegalServiceLayout from '../../components/LegalServiceLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
interface PropertyService { title: string; description: string; }
const services: readonly PropertyService[] = [
  { title: 'For Sale By Owner (FSBO) Assistance & Contract Review', description: 'Review offers, purchase contracts, and transaction documents so you understand your obligations, deadlines, and allocation of risk. Receive legal guidance for a Wisconsin sale or purchase even when you are handling the transaction without a listing agent.' },
  { title: 'Title Commitment and Contingency Reviews', description: 'Examine title commitments, exceptions, and the steps needed to address identified issues. Review financing, inspection, appraisal, and other contingencies with attention to notice requirements and transaction deadlines.' },
  { title: 'Deed Preparation', description: 'Prepare an appropriate conveyance document for the transaction, including a Warranty Deed or Quitclaim Deed. Evaluate a Transfer on Death (TOD) Deed for qualifying property interests to pass outside probate at death. Proper drafting and recording matter; a TOD designation does not cure title defects or automatically eliminate taxes, liens, or Medicaid estate-recovery exposure.' },
  { title: 'Real Estate Dispute Mediation', description: 'Explore neutral mediation of earnest-money disagreements, defect claims, and other property disputes. Parties can work toward a voluntary resolution with a mediator facilitating communication, rather than representing either side.' },
];
---
<LegalServiceLayout title="Wisconsin Real Estate Legal Services" description="Virtual Wisconsin legal counsel for FSBO contracts, title commitments, contingencies, deed preparation, TOD planning, and real estate dispute mediation." canonicalPath="/legal-services/real-estate" breadcrumbLabel="Real Estate Transactions" headline="Clear Titles, Secure Contracts: Wisconsin Real Estate Legal Services" subheadline="Professional, virtual legal counsel to protect your property investments and ensure smooth closings—without the office visit." ctaHeading="Discuss your Wisconsin property transaction.">
  <section class="container-shell py-16 sm:py-24" aria-labelledby="property-services-title"><h2 id="property-services-title" class="text-3xl text-forest sm:text-4xl">Wisconsin Real Estate Practice Areas</h2><div class="mt-10 grid gap-6 md:grid-cols-2">{services.map((service) => <article class="border border-forest/20 bg-white p-7 sm:p-9"><h3 class="text-2xl leading-snug text-forest">{service.title}</h3><p class="mt-5 text-base leading-8 text-onyx/80">{service.description}</p></article>)}</div></section>
  <section class="border-y border-gold/30 bg-forest-dark py-16 text-parchment sm:py-20" aria-labelledby="property-mediation-title"><div class="container-shell grid items-center gap-8 lg:grid-cols-[1fr_auto]"><div><h2 id="property-mediation-title" class="text-3xl leading-tight sm:text-4xl">A neutral path for property disputes.</h2><p class="mt-6 max-w-3xl text-base leading-8 text-parchment/80">Mediation is a separate service from legal representation. When Patrick Rowe serves as mediator, he does not act as either party’s attorney or provide legal advice to participants.</p></div><CTAButton href="/mediation" variant="secondary">Explore Virtual Mediation</CTAButton></div></section>
</LegalServiceLayout>
