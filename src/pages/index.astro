---
import BaseLayout from '../components/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';

interface Feature { title: string; description: string; }
interface PracticePreview extends Feature { href: string; }
const badges: readonly string[] = [
  '100% Virtual Consultations',
  'Licensed in Wisconsin & Florida',
  'Court-Appointed GAL',
];
const advantages: readonly Feature[] = [
  { title: 'Zero Travel, Zero Hassle', description: 'No driving to a downtown office or paying for parking. Meet securely via phone or high-definition video.' },
  { title: 'A Dual Perspective', description: 'As both an active Wisconsin litigator and an experienced mediator in two states, Patrick Rowe understands how courts view these issues—and how to help you avoid them.' },
  { title: 'Stress-Free Environment', description: 'Discuss sensitive family, estate, business, or property matters from a space where you feel completely comfortable.' },
];
const practices: readonly PracticePreview[] = [
  { title: 'Divorce', description: 'Legal representation and strategic negotiation for Wisconsin divorce matters.', href: '/legal-services/divorce-family-law' },
  { title: 'Custody', description: 'Counsel for Wisconsin custody and placement matters involving your family.', href: '/legal-services/custody-placement' },
  { title: 'Estate & Medicaid Planning', description: 'Strategic planning for your estate and future care needs.', href: '/legal-services/estate-medicaid-planning' },
  { title: 'Business Succession', description: 'Legal planning for the next chapter of your business.', href: '/legal-services/business-succession' },
  { title: 'Guardianships', description: 'Wisconsin legal counsel for guardianship matters.', href: '/legal-services/guardianships' },
];
const attorneyFeatures = ['Courtroom advocacy', 'Document drafting', 'Strategic negotiation', 'Virtual court appearances'];
const mediatorFeatures = ['Neutral facilitation', '100% remote via secure video', 'Cost-effective', 'Voluntary resolution'];
---
<BaseLayout
  title="Wisconsin Attorney & Virtual Family Mediation in WI & FL"
  description="Meet with Patrick Rowe from home or office. Wisconsin legal representation and virtual family mediation in Wisconsin and Florida at Rowe Law Office, LLC."
  canonicalPath="/"
>
  <section class="home-hero relative isolate overflow-hidden bg-forest text-parchment" aria-labelledby="hero-title">
    <div aria-hidden="true" class="hero-geometry pointer-events-none absolute -right-32 top-20 -z-10 hidden h-[32rem] w-[32rem] rotate-45 border border-gold/25 sm:block">
      <div class="absolute inset-12 border border-gold/15"></div>
      <div class="absolute inset-24 border border-gold/10"></div>
    </div>
    <div class="container-shell py-20 sm:py-24 lg:py-28">
      <h1 id="hero-title" class="max-w-4xl text-4xl leading-[1.14] sm:text-6xl lg:text-7xl">Legal Resolution, Reimagined for Your Convenience.</h1>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-parchment/85 sm:text-xl sm:leading-9">Trusted Wisconsin legal representation and expert virtual family mediation in Wisconsin and Florida—handled entirely from the comfort of your home or office.</p>
      <div class="mt-10 flex flex-col items-stretch gap-4 sm:flex-row sm:items-start">
        <CTAButton href="/contact">Book a Virtual Consultation</CTAButton>
        <CTAButton href="/mediation" variant="secondary">Explore Mediation Services</CTAButton>
      </div>
      <ul aria-label="Practice credentials and consultation format" class="mt-14 grid gap-5 border-t border-gold/25 pt-7 sm:flex sm:flex-wrap sm:gap-x-10 sm:gap-y-5">
        {badges.map((badge) => <li class="flex items-center gap-3 text-sm font-medium text-gold-light">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="shrink-0" aria-hidden="true"><path d="m5 12 4 4L19 6" /><path d="M21 12v8H3V4h12" /></svg>
          {badge}
        </li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="portal-title" class="container-shell py-16 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="portal-title" class="text-3xl leading-tight text-forest sm:text-5xl">How would you like to move forward?</h2>
      <p class="mt-6 text-base leading-8 text-onyx/75 sm:text-lg">To ensure you get the exact help you need, please choose the path that fits your situation:</p>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-8">
      <article class="portal-card flex min-w-0 flex-col border border-forest/25 bg-white p-7 text-forest shadow-sm transition-[border-color,box-shadow] hover:border-gold-dark hover:shadow-xl focus-within:border-gold-dark sm:p-10">
        <span aria-hidden="true" class="mb-8 flex h-14 w-14 items-center justify-center border border-forest/20">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M16 5v22M9 27h14M5 10h22M7 10 3 20h8L7 10ZM25 10l-4 10h8L25 10Z" stroke-linejoin="round" /></svg>
        </span>
        <h3 class="text-3xl leading-tight sm:text-4xl">I Need a Wisconsin Attorney</h3>
        <p class="mt-6 text-base leading-8 text-onyx/75">Seeking an advocate to represent your interests in family law, estate &amp; Medicaid planning, business succession, or real estate?</p>
        <ul class="my-8 grid gap-3 text-base leading-7">
          {attorneyFeatures.map((feature) => <li class="flex gap-3"><span aria-hidden="true" class="text-gold-dark">✓</span>{feature}</li>)}
        </ul>
        <CTAButton href="/legal-services" variant="outline" classes="mt-auto w-full">View WI Legal Services</CTAButton>
      </article>
      <article class="portal-card flex min-w-0 flex-col border border-gold/60 bg-forest p-7 text-parchment shadow-sm transition-[border-color,box-shadow] hover:border-gold-light hover:shadow-xl focus-within:border-gold-light sm:p-10">
        <span aria-hidden="true" class="mb-8 flex h-14 w-14 items-center justify-center border border-gold/45 text-gold-light">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="6" width="26" height="18" rx="2" /><path d="M11 28h10M16 24v4" /><circle cx="16" cy="12" r="3" /><path d="M10 21v-1a6 6 0 0 1 12 0v1" /></svg>
        </span>
        <h3 class="text-3xl leading-tight sm:text-4xl">I Need a Virtual Mediator (WI &amp; FL)</h3>
        <p class="mt-6 text-base leading-8 text-parchment/80">Seeking a neutral third party to help resolve a dispute peacefully via video? (Available for all WI matters and FL Family Law).</p>
        <ul class="my-8 grid gap-3 text-base leading-7">
          {mediatorFeatures.map((feature) => <li class="flex gap-3"><span aria-hidden="true" class="text-gold-light">✓</span>{feature}</li>)}
        </ul>
        <CTAButton href="/mediation" classes="mt-auto w-full">View Virtual Mediation</CTAButton>
      </article>
    </div>
  </section>

  <section aria-labelledby="advantage-title" class="border-y border-forest/15 bg-forest/5 py-16 sm:py-24">
    <div class="container-shell">
      <h2 id="advantage-title" class="text-3xl text-forest sm:text-5xl">Why Choose Rowe Law Office?</h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {advantages.map((feature, index) => <article class="border-t-2 border-gold bg-parchment p-7 sm:p-8">
          <span aria-hidden="true" class="text-sm font-semibold tracking-widest text-forest/65">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-6 text-2xl leading-tight text-forest sm:text-3xl">{feature.title}</h3>
          <p class="mt-5 text-base leading-8 text-onyx/75">{feature.description}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section aria-labelledby="practice-title" class="container-shell py-16 sm:py-24">
    <h2 id="practice-title" class="text-3xl text-forest sm:text-5xl">Featured Practice Areas</h2>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {practices.map((practice) => <li class="min-w-0">
        <a href={practice.href} class="group block h-full border border-forest/20 bg-white p-7 transition-colors hover:border-gold-dark hover:bg-forest/5 focus-visible:border-gold-dark sm:p-8">
          <h3 class="text-2xl leading-tight text-forest group-hover:underline underline-offset-4">{practice.title}</h3>
          <p class="mt-5 text-base leading-7 text-onyx/75">{practice.description}</p>
        </a>
      </li>)}
    </ul>
  </section>

  <section aria-labelledby="conversion-title" class="border-t border-gold/45 bg-forest text-parchment">
    <div class="container-shell grid items-center gap-8 py-16 sm:py-20 lg:grid-cols-[1fr_auto] lg:gap-12">
      <div>
        <h2 id="conversion-title" class="max-w-3xl text-3xl leading-tight sm:text-5xl">Take the first step toward resolution—without stepping outside your home.</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-parchment/80">Start with a virtual consultation from a place where you feel comfortable.</p>
      </div>
      <CTAButton href="/contact">Book a Virtual Consultation</CTAButton>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    background-image: radial-gradient(ellipse at 90% 45%, transparent 10%, rgb(11 13 12 / 0.56) 100%), linear-gradient(120deg, #0E2F24, #164334);
  }
</style>
