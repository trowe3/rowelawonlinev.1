---
import BaseLayout from '../components/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
---
<BaseLayout title="Page Not Found" description="The requested page could not be found at Rowe Law Office, LLC." canonicalPath="/404">
  <meta slot="head" name="robots" content="noindex" />
  <section class="container-shell py-24"><p class="eyebrow text-forest">404</p><h1 class="mt-5 text-5xl">Page not found.</h1><p class="mt-6 text-lg">Return to the homepage to find the information you need.</p><CTAButton href="/" classes="mt-8">Return Home</CTAButton></section>
</BaseLayout>
