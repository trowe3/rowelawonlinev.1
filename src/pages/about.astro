---
import BaseLayout from '../components/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

interface Feature { title: string; description: string; }
const pillars: readonly Feature[] = [
  { title: 'Wisconsin Attorney & Litigator', description: 'Zealous legal advocate handling family law, complex estate/Medicaid planning, business succession, and property transactions throughout Wisconsin.' },
  { title: 'Court-Appointed Guardian ad Litem (GAL)', description: 'Trusted by Wisconsin circuit courts to advocate for the best interests of minors and vulnerable adults, bringing unmatched insight into family court dynamics.' },
  { title: 'Certified Virtual Mediator (WI & FL)', description: 'Impartial dispute resolution specialist facilitating constructive, peaceful settlements for Wisconsin civil/family disputes and Florida family law matters.' },
];
const values: readonly Feature[] = [
  { title: 'Integrity', description: 'A clear commitment to legal advocacy when representing clients and impartiality when serving as a mediator.' },
  { title: 'Accessibility', description: 'Meet from your home or office, with geographical barriers reduced through a virtual practice model.' },
  { title: 'Efficiency', description: 'Focused conversations and a streamlined approach that respects your time.' },
  { title: 'Modern Virtual Infrastructure', description: 'Secure video and phone consultations designed to make working together convenient.' },
];
---
<BaseLayout
  title="About Patrick Rowe | Wisconsin Attorney & Virtual Mediator"
  description="Meet Patrick Rowe, founder of Rowe Law Office, LLC: Wisconsin attorney, court-appointed guardian ad litem, and certified virtual mediator for WI and FL family law."
  canonicalPath="/about"
>
  <section aria-labelledby="about-title" class="border-b border-gold/40 bg-forest-dark text-parchment">
    <div class="container-shell py-16 sm:py-24">
      <h1 id="about-title" class="max-w-5xl text-4xl leading-[1.15] sm:text-6xl">Experienced Advocate. Trusted Mediator. A Modern Approach to the Law.</h1>
      <p class="mt-8 max-w-3xl text-lg leading-8 text-parchment/85 sm:text-xl sm:leading-9">Meet Patrick Rowe—providing strategic Wisconsin legal representation and expert virtual dispute resolution across Wisconsin and Florida.</p>
    </div>
  </section>

  <section aria-labelledby="profile-title" class="container-shell grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[0.9fr_1.25fr] lg:gap-20">
    <div class="mx-auto w-full max-w-md lg:mx-0">
      <div class="border border-gold/65 p-3"><ImagePlaceholder aspectRatio="portrait" label="Patrick Rowe Professional Headshot" /></div>
      <p class="mt-5 border-l-2 border-gold pl-4 text-sm font-medium leading-7 text-forest">Patrick Rowe, Esq. | Founder &amp; Virtual Dispute Specialist</p>
    </div>
    <div class="min-w-0">
      <h2 id="profile-title" class="text-3xl leading-tight text-forest sm:text-4xl">Meet Patrick Rowe</h2>
      <div class="mt-7 space-y-6 text-base leading-8 text-onyx/80 sm:text-lg sm:leading-9">
        <p>Patrick Rowe founded Rowe Law Office, LLC to bring strategic legal counsel and constructive dispute resolution into a modern, accessible practice. As a Wisconsin attorney and litigator, a court-appointed guardian ad litem, and a virtual mediator serving Wisconsin and Florida family law matters, he brings multiple perspectives to the issues people face.</p>
        <p>His philosophy begins with the path your situation requires: a legal advocate to represent your interests, or a neutral mediator to help the parties work toward a voluntary resolution. His experience in Wisconsin courts informs his approach to advocacy and the practical perspective he brings to mediation.</p>
        <p>Patrick's tech-forward practice makes it possible to connect by secure video or phone from your home or office. By reducing travel, scheduling friction, and geographical barriers, the virtual model keeps the focus on your legal matter or dispute rather than the logistics of an office visit.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="pillars-title" class="border-y border-forest/15 bg-forest/5 py-16 sm:py-24">
    <div class="container-shell">
      <h2 id="pillars-title" class="text-3xl leading-tight text-forest sm:text-5xl">The Multi-Dimensional Advantage</h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {pillars.map((pillar, index) => <article class="min-w-0 border-t-2 border-gold bg-parchment p-7 sm:p-8">
          <span aria-hidden="true" class="text-sm font-semibold tracking-widest text-forest/65">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-6 text-2xl leading-snug text-forest">{pillar.title}</h3>
          <p class="mt-5 text-base leading-8 text-onyx/75">{pillar.description}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section aria-labelledby="values-title" class="container-shell py-16 sm:py-24">
    <h2 id="values-title" class="text-3xl text-forest sm:text-5xl">Core Values</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {values.map((value) => <article class="border border-forest/20 bg-white p-7">
        <h3 class="text-2xl leading-snug text-forest">{value.title}</h3>
        <p class="mt-5 text-base leading-8 text-onyx/75">{value.description}</p>
      </article>)}
    </div>
  </section>

  <section aria-labelledby="about-cta-title" class="container-shell pb-16 sm:pb-24">
    <div class="border border-gold/60 bg-forest p-7 text-parchment sm:p-12">
      <h2 id="about-cta-title" class="text-3xl leading-tight sm:text-5xl">Choose your path to resolution.</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-12">
        <div class="flex min-w-0 flex-col items-start">
          <h3 class="text-2xl text-gold-light">Work with a Wisconsin attorney</h3>
          <p class="mt-4 mb-7 text-base leading-8 text-parchment/80">Schedule a virtual consultation to discuss legal representation for your Wisconsin matter.</p>
          <CTAButton href="/contact" classes="mt-auto w-full sm:w-auto">Schedule an Attorney Consultation</CTAButton>
        </div>
        <div class="flex min-w-0 flex-col items-start border-t border-gold/30 pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
          <h3 class="text-2xl text-gold-light">Work with a neutral mediator</h3>
          <p class="mt-4 mb-7 text-base leading-8 text-parchment/80">Book a virtual mediation session for a Wisconsin dispute or a Florida family law matter.</p>
          <CTAButton href="/contact" variant="secondary" classes="mt-auto w-full sm:w-auto">Book a Mediation Session</CTAButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
